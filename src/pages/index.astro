---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllCategories } from '../lib/categories';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const db = getDatabase();
const [games, categories, publishers] = await Promise.all([
  getAllGames(db),
  getAllCategories(db),
  getAllPublishers(db),
]);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <form
            class="mb-8 grid gap-4 rounded-xl border border-slate-700 bg-slate-800/60 p-6 shadow-lg sm:grid-cols-2"
            data-testid="filter-form"
          >
            <div>
              <label for="category-filter" class="mb-2 block font-medium text-slate-100">
                Categories
              </label>
              <select
                id="category-filter"
                name="categories"
                multiple
                size={Math.min(Math.max(categories.length, 2), 5)}
                aria-describedby="category-filter-help"
                data-testid="category-filter"
                class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
              >
                {categories.map((category) => (
                  <option value={category.id}>{category.name}</option>
                ))}
              </select>
              <p id="category-filter-help" class="mt-2 text-sm text-slate-400">
                Select one or more categories.
              </p>
            </div>

            <div>
              <label for="publisher-filter" class="mb-2 block font-medium text-slate-100">
                Publisher
              </label>
              <select
                id="publisher-filter"
                name="publisher"
                data-testid="publisher-filter"
                class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
              >
                <option value="">All publishers</option>
                {publishers.map((publisher) => (
                  <option value={publisher.id}>{publisher.name}</option>
                ))}
              </select>
            </div>

            <div class="flex items-center justify-between gap-4 sm:col-span-2">
              <p data-testid="filter-results-status" role="status" aria-live="polite" class="text-sm text-slate-300">
                Showing {games.length} {games.length === 1 ? 'game' : 'games'}.
              </p>
              <button
                type="reset"
                data-testid="reset-filters"
                class="rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-100 transition-colors hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500"
              >
                Reset filters
              </button>
            </div>
          </form>

          <div
            data-testid="filtered-empty-state"
            hidden
            class="mb-6 rounded-xl border border-slate-700 bg-slate-800/50 py-12 text-center text-slate-300"
          >
            No games match the selected filters.
          </div>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const filterForm = document.querySelector<HTMLFormElement>('[data-testid="filter-form"]');
  const categoryFilter = document.querySelector<HTMLSelectElement>('[data-testid="category-filter"]');
  const publisherFilter = document.querySelector<HTMLSelectElement>('[data-testid="publisher-filter"]');
  const resetFilters = document.querySelector<HTMLButtonElement>('[data-testid="reset-filters"]');
  const resultsStatus = document.querySelector<HTMLElement>('[data-testid="filter-results-status"]');
  const filteredEmptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');
  const gameCards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));

  function applyFilters(): void {
    if (!categoryFilter || !publisherFilter || !resultsStatus || !filteredEmptyState) return;

    const selectedCategories = new Set(
      Array.from(categoryFilter.selectedOptions, (option) => option.value),
    );
    const selectedPublisher = publisherFilter.value;
    let visibleCount = 0;

    for (const card of gameCards) {
      const categoryMatches =
        selectedCategories.size === 0 || selectedCategories.has(card.dataset.categoryId ?? '');
      const publisherMatches =
        selectedPublisher === '' || card.dataset.publisherId === selectedPublisher;
      const matches = categoryMatches && publisherMatches;

      card.hidden = !matches;
      if (matches) visibleCount += 1;
    }

    resultsStatus.textContent = `Showing ${visibleCount} ${visibleCount === 1 ? 'game' : 'games'}.`;
    filteredEmptyState.hidden = visibleCount > 0;
  }

  filterForm?.addEventListener('change', applyFilters);
  resetFilters?.addEventListener('click', () => {
    requestAnimationFrame(applyFilters);
  });
</script>
